    <!-- Mobile Menu Toggle -->
    <button class="aesop-header__mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Open navigation menu">
      <svg class="aesop-header__icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M3 12H21M3 6H21M3 18H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <!-- Logo -->
    <div class="aesop-header__logo">
      {%- if request.page_type == 'index' -%}
        <h1>
      {%- endif -%}
      <a href="{{ routes.root_url }}" class="aesop-header__logo-link"> Aēsop </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    </div>

    <!-- Main Navigation -->
    <nav class="aesop-header__nav" role="navigation">
      <ul class="aesop-header__menu" role="menubar">
        {% comment %} New & Notable {% endcomment %}
