{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .certifications-container {
    background-color: rgb(255, 254, 243);
    width: 100%;
    padding: 4rem 0;
  }

  .certifications-quote {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    padding: 0 2rem;
    margin-bottom: 4rem;
  }

  .certifications-quote h2 {
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 1rem;
    font-weight: normal;
  }

  .certifications-quote .author {
    font-size: 1rem;
    color: #333;
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 0 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .certification-item {
    background-color: rgb(246, 245, 233);
    padding: 3rem 2rem;
    text-align: center;
  }

  .certification-item h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
    font-weight: normal;
  }

  .certification-item p {
    font-size: 1rem;
    line-height: 1.5;
    max-width: 400px;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .certifications-grid {
      grid-template-columns: 1fr;
    }

    .certifications-quote h2 {
      font-size: 2rem;
    }
  }
{% endstyle %}

<div class="certifications-container section-{{ section.id }}-padding">
  <div class="certifications-quote">
    <h2>{{ section.settings.quote_text }}</h2>
    <div class="author">{{ section.settings.quote_author }}</div>
  </div>

  <div class="certifications-grid">
    <div class="certification-item">
      <h3>{{ section.settings.cert1_title }}</h3>
      <p>{{ section.settings.cert1_text }}</p>
    </div>
    <div class="certification-item">
      <h3>{{ section.settings.cert2_title }}</h3>
      <p>{{ section.settings.cert2_text }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Certifications",
  "settings": [
    {
      "type": "text",
      "id": "quote_text",
      "label": "Quote Text",
      "default": "Poetry must have something in it that is barbaric, vast and wild."
    },
    {
      "type": "text",
      "id": "quote_author",
      "label": "Quote Author",
      "default": "Denis Diderot"
    },
    {
      "type": "text",
      "id": "cert1_title",
      "label": "First Certification Title",
      "default": "Certified B Corp"
    },
    {
      "type": "text",
      "id": "cert1_text",
      "label": "First Certification Text",
      "default": "We meet the highest verified standards of social and environmental performance, transparency and accountability."
    },
    {
      "type": "text",
      "id": "cert2_title",
      "label": "Second Certification Title",
      "default": "Leaping Bunny Approved"
    },
    {
      "type": "text",
      "id": "cert2_text",
      "label": "Second Certification Text",
      "default": "Our formulations are approved as cruelty free under the Cruelty Free International Leaping Bunny programme."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Certifications"
    }
  ]
}
{% endschema %}
