{{ 'section-aesop-product-grid.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="aesop-product-grid color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    {% if section.settings.title != blank %}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin">
        <h2 id="SectionHeading-{{ section.id }}" class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div>
    {% endif %}

    {% if section.settings.description != blank %}
      <div class="collection-hero__description rte">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="aesop-product-grid__wrapper">
      {% for block in section.blocks %}
        <div class="aesop-product-grid__item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="aesop-product-grid__link">
          {% endif %}
          <div class="aesop-product-grid__image-wrapper">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy"
                class="aesop-product-grid__image"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {% else %}
              <div class="aesop-product-grid__placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
          </div>
          {% if block.settings.overlay_text != blank %}
            <div class="aesop-product-grid__content">
              <h3 class="aesop-product-grid__title">
                {{ block.settings.overlay_text }}
                <span class="aesop-product-grid__arrow">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </h3>
              {% if block.settings.overlay_subtitle != blank %}
                <p class="aesop-product-grid__subtitle">{{ block.settings.overlay_subtitle }}</p>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Aesop Product Grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "产品分类",
      "label": "标题"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "小"
        },
        {
          "value": "h1",
          "label": "中"
        },
        {
          "value": "h0",
          "label": "大"
        }
      ],
      "default": "h1",
      "label": "标题大小"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "颜色方案",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部间距",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部间距",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "grid_item",
      "name": "网格项目",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "overlay_text",
          "label": "覆盖文字",
          "default": "产品分类"
        },
        {
          "type": "text",
          "id": "overlay_subtitle",
          "label": "副标题"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接地址"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aesop Product Grid",
      "blocks": [
        {
          "type": "grid_item",
          "settings": {
            "overlay_text": "Hand Washes & Balms"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "overlay_text": "Body Cleansers & Scrubs"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "overlay_text": "Fragrance"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "overlay_text": "Gifts For Travel"
          }
        },
        {
          "type": "grid_item",
          "settings": {
            "overlay_text": "Body Balms & Oils"
          }
        }
      ]
    }
  ]
}
{% endschema %}
