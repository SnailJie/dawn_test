{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    <!-- WOMEN Navigation -->
    <li>
      <header-menu>
        <details id="Details-HeaderMenu-Women" class="mega-menu">
          <summary
            id="HeaderMenu-women"
            class="header__menu-item list-menu__item link focus-inset"
          >
            <span>WOMEN</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div
            id="MegaMenu-Content-Women"
            class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
            tabindex="-1"
          >
            <ul class="mega-menu__list page-width" role="list">
              <li>
                <a
                  href="{{ routes.collections_url }}/coordinated-set"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Coordinated set
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/blouse-tops"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Blouse & Tops
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/coats-jackets"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Coats & Jackets
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/suits"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Suits
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/dresses"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Dresses
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/cheongsam-women"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Cheongsam
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/tweeds"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Tweeds
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/vests"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Vests
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/women"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  View All
                </a>
              </li>
            </ul>
          </div>
        </details>
      </header-menu>
    </li>

    <!-- MEN Navigation -->
    <li>
      <header-menu>
        <details id="Details-HeaderMenu-Men" class="mega-menu">
          <summary
            id="HeaderMenu-men"
            class="header__menu-item list-menu__item link focus-inset"
          >
            <span>MEN</span>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div
            id="MegaMenu-Content-Men"
            class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
            tabindex="-1"
          >
            <ul class="mega-menu__list page-width" role="list">
              <li>
                <a
                  href="{{ routes.collections_url }}/men-suits"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Suits
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/men-jackets"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Jackets
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/men-shirts"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Shirts
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/tang-suits"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Tang Suits
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/cheongsam-men"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  Cheongsam
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.collections_url }}/men"
                  class="mega-menu__link mega-menu__link--level-2 link"
                >
                  View All
                </a>
              </li>
            </ul>
          </div>
        </details>
      </header-menu>
    </li>
  </ul>
</nav>
