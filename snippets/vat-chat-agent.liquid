{%- comment -%}
  VAT Chat Agent 集成（仅首页引入）
  - 引入 iframe-bridge 脚本
  - 引入 vat-chat-agent 样式
  - 通过 importmap 加载 React/ReactDOM，并在 window 上暴露后动态加载 vat-chat-agent
{%- endcomment -%}

<link
  rel="stylesheet"
  href="https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_vat-chat-agent/1.0.5/dist/vat-chat-agent.min.css"
>
<script
  src="https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_iframe-bridge/1.0.2/dist/iframe-bridge.min.js"
  defer
></script>

<script type="importmap">
  {
    "imports": {
      "react": "https://esm.sh/react@19",
      "react-dom": "https://esm.sh/react-dom@19",
      "react-dom/client": "https://esm.sh/react-dom@19/client"
    }
  }
</script>

<script type="module">
  import React from 'react';
  import * as ReactDOM from 'react-dom';
  import * as ReactDOMClient from 'react-dom/client';

  window.React = React;
  window.ReactDOM = { ...ReactDOM, ...ReactDOMClient };

  const script = document.createElement('script');
  script.src =
    'https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_vat-chat-agent/1.0.5/dist/vat-chat-agent.min.js';
  script.async = true;
  script.addEventListener('load', () => {
    try {
      const root =
        document.getElementById('vat-agent-root') ||
        (() => {
          const div = document.createElement('div');
          div.id = 'vat-agent-root';
          div.className = 'vat-agent-floating-container';
          document.body.appendChild(div);
          return div;
        })();
      if (!root.querySelector('vat-chat-agent')) {
        const el = document.createElement('vat-chat-agent');
        root.appendChild(el);
      }
    } catch (e) {
      console.error('[vat-chat-agent] mount failed', e);
    }
  });
  document.head.appendChild(script);
</script>

<style>
  .vat-agent-floating-container {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 2147483000;
    pointer-events: auto;
  }
</style>

<div id="vat-agent-root" class="vat-agent-floating-container"></div>
