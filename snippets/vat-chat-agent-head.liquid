{%- comment -%}
  VAT Chat Agent 头部资源（首页专用）
  - 放置在 <head>
  - 使用 UMD 版本 React / ReactDOM，避免 importmap 兼容和 CSP 问题
  - 动态创建悬浮容器并注入 <vat-chat-agent>
{%- endcomment -%}

<link
  rel="stylesheet"
  href="https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_vat-chat-agent/1.0.5/dist/vat-chat-agent.min.css"
>
<script
  src="https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_iframe-bridge/1.0.2/dist/iframe-bridge.min.js"
  defer
></script>
<script src="https://unpkg.com/react@18/umd/react.production.min.js" defer></script>
<script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" defer></script>

<style>
  .vat-agent-floating-container {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 2147483000;
    pointer-events: auto;
  }
</style>

<script defer>
  (function () {
    function mountAgent() {
      try {
        var root = document.getElementById('vat-agent-root');
        if (!root) {
          root = document.createElement('div');
          root.id = 'vat-agent-root';
          root.className = 'vat-agent-floating-container';
          document.body.appendChild(root);
        }
        if (!root.querySelector('vat-chat-agent')) {
          var el = document.createElement('vat-chat-agent');
          root.appendChild(el);
        }
      } catch (e) {
        console.error('[vat-chat-agent] mount failed', e);
      }
    }

    function loadAgentScript() {
      var script = document.createElement('script');
      script.src =
        'https://gw.alipayobjects.com/render/p/yuyan_npm/@alipay_vat-chat-agent/1.0.5/dist/vat-chat-agent.min.js';
      script.async = true;
      script.addEventListener('load', mountAgent);
      document.head.appendChild(script);
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      loadAgentScript();
    } else {
      document.addEventListener('DOMContentLoaded', loadAgentScript);
    }
  })();
</script>
